! SnO2 (rutile, P4_2/mnm) - PBE0 (hybrid) SCF run prepared for LOBSTER
! LOBSTER needs: PAW pseudopotentials, nosym/noinv (full k-grid), extra empty bands
&CONTROL
  calculation = 'scf'
  prefix      = 'SnO2'
  outdir      = './'
  pseudo_dir  = '../pseudo'
  wf_collect  = .true.
  verbosity   = 'high'
/
&SYSTEM
  ibrav     = 6
  celldm(1) = 8.95160        ! a = 4.737 Angstrom (experimental)
  celldm(3) = 0.67258        ! c/a, c = 3.186 Angstrom
  nat       = 6
  ntyp      = 2
  ecutwfc   = 50
  ecutrho   = 400
  nbnd      = 48             ! 26 occupied; LOBSTER needs >= 34 basis functions
  occupations = 'fixed'
  input_dft = 'pbe0'        ! 25% exact exchange (PBE0)
  ecutfock  = 200           ! cutoff for the Fock operator (4 x ecutwfc)
  nqx1 = 3, nqx2 = 3, nqx3 = 3   ! q-grid for exact exchange (must divide the 6x6x9 k-grid)
  exxdiv_treatment = 'gygi-baldereschi'
  nosym     = .true.
  noinv     = .true.
/
&ELECTRONS
  conv_thr    = 1.0d-9
  mixing_beta = 0.4
/
ATOMIC_SPECIES
  Sn  118.710  Sn.pbe-dn-kjpaw_psl.1.0.0.UPF
  O    15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Sn  0.000  0.000  0.000
  Sn  0.500  0.500  0.500
  O   0.307  0.307  0.000
  O   0.693  0.693  0.000
  O   0.807  0.193  0.500
  O   0.193  0.807  0.500
K_POINTS automatic
  6 6 9 0 0 0
