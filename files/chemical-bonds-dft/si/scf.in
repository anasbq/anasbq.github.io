! Si (diamond) - single SCF run prepared for LOBSTER
! LOBSTER needs: PAW pseudopotentials, nosym/noinv (full k-grid), extra empty bands
&CONTROL
  calculation = 'scf'
  prefix      = 'Si'
  outdir      = './'
  pseudo_dir  = '../pseudo'
  wf_collect  = .true.
  verbosity   = 'high'
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 10.2631        ! a = 5.431 Angstrom (experimental)
  nat       = 2
  ntyp      = 1
  ecutwfc   = 50
  ecutrho   = 400
  nbnd      = 16             ! 4 occupied; LOBSTER needs >= 8 basis functions
  occupations = 'fixed'
  nosym     = .true.
  noinv     = .true.
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  8 8 8 0 0 0
